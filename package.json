    "diag:ta-mode-auto:strict": "node --import tsx diagnostics/ta-rms-lightweight-mode-auto.mjs --min-median-of-median-speedup 0.99 --min-per-raycount-speedup 0.97",
    "diag:native-operands-auto": "node --experimental-strip-types diagnostics/native-operands-auto.mjs",
