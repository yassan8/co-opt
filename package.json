    "diag:image-simulation-model": "node --experimental-strip-types diagnostics/image-simulation-model-repro.mjs",
    "diag:image-simulation-conjugates": "node --experimental-strip-types diagnostics/image-simulation-conjugate-repro.mjs",
    "diag:image-simulation-ui": "node diagnostics/image-simulation-ui-repro.mjs",
    "diag:coherent-interferometer": "node --import tsx diagnostics/coherent-interferometer-verification.mjs",
    "diag:coherent-assembly": "node --import tsx diagnostics/coherent-assembly-verification.mjs",
    "diag:nonsequential-optics": "node --import tsx diagnostics/nonsequential-optics-verification.mjs",
    "diag:coherent-design-intent": "node --import tsx diagnostics/coherent-design-intent-bridge-verification.mjs",
    "diag:coherent-port-layout": "node --import tsx diagnostics/coherent-port-layout-verification.mjs",
    "diag:hybrid-assembly": "node --import tsx diagnostics/hybrid-assembly-verification.mjs",
    "diag:optimizer-mtf-shared": "node --import tsx diagnostics/optimizer-mtf-shared-batch-repro.mjs",
