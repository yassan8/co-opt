{
  "name": "co-opt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vite build",
    "preview": "vite preview",
    "diag:opd": "node --experimental-strip-types diagnostics/opd-benchmark.mjs",
    "diag:opd-full-batch": "node --experimental-strip-types diagnostics/opd-full-batch-benchmark.mjs",
    "diag:opd-full-batch-analyze": "node --experimental-strip-types diagnostics/opd-full-batch-analyze.mjs",
    "diag:opd-full-batch-analyze:strict": "node --experimental-strip-types diagnostics/opd-full-batch-analyze.mjs --require true --min-speedup 1.05 --max-valid-diff 0",
    "diag:opd-full-batch-auto": "node --experimental-strip-types diagnostics/opd-full-batch-auto.mjs",
    "diag:opd-full-batch-auto:strict": "node --experimental-strip-types diagnostics/opd-full-batch-auto.mjs --min-speedup 1.05 --max-valid-diff 0",
    "diag:kkt-e2e": "node --experimental-strip-types diagnostics/kkt-e2e-benchmark.mjs",
    "diag:kkt-e2e-analyze": "node --experimental-strip-types diagnostics/kkt-e2e-analyze.mjs",
    "diag:kkt-e2e-auto": "node --experimental-strip-types diagnostics/kkt-e2e-auto.mjs",
    "diag:kkt-e2e-auto:strict": "node --experimental-strip-types diagnostics/kkt-e2e-auto.mjs --min-total-speedup 1.5 --min-solver-speedup 1.0 --min-wasm-ok-rate 1.0 --min-wasm-feasible-rate 1.0",
    "diag:kkt-qp": "node --experimental-strip-types diagnostics/kkt-qp-benchmark.mjs",
    "diag:release-gate": "node --experimental-strip-types diagnostics/release-gate-auto.mjs",
    "diag:release-gate:strict": "node diagnostics/release-gate-auto.mjs --ray-max-mismatch-rate 0 --ray-max-success-mismatch-rate 0 --ray-max-mean-opl-um 0 --ray-max-opl-um 0 --opd-min-speedup 1.05 --opd-max-valid-diff 0 --kkt-min-total-speedup 1.5 --kkt-min-solver-speedup 1.0 --kkt-min-wasm-ok-rate 1.0 --kkt-min-wasm-feasible-rate 1.0 --kkt-rounds 6 --kkt-n 24 --kkt-meq 6 --kkt-mineq 6 --kkt-maxIter 20",
    "diag:raytrace-golden": "node --experimental-strip-types diagnostics/raytrace-golden-capture.mjs",
    "diag:raytrace-golden:both": "node --experimental-strip-types diagnostics/raytrace-golden-capture.mjs --engine both",
    "diag:raytrace-golden:both:quick": "node --experimental-strip-types diagnostics/raytrace-golden-capture.mjs --engine both --rays 25",
    "diag:raytrace-analyze": "node --experimental-strip-types diagnostics/raytrace-golden-analyze.mjs",
    "diag:raytrace-auto": "node --experimental-strip-types diagnostics/raytrace-golden-auto.mjs",
    "diag:toric-lockstep": "node --experimental-strip-types diagnostics/toric-lockstep-benchmark.mjs",
    "diag:zernike-fit": "node --experimental-strip-types diagnostics/zernike-fit-benchmark.mjs",
    "diag:zernike-fit-ab": "node --experimental-strip-types diagnostics/zernike-fit-ab-benchmark.mjs",
    "wasm:rebuild": "bash ./scripts/build-rust-wasm.sh",
    "state:inventory": "node tools/state-inventory.mjs",
    "pr:all": "bash ./scripts/pr-all.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
