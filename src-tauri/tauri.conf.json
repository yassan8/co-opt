{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "co-opt-pro",
  "version": "0.1.0",
  "identifier": "com.coopt.pro",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "co-opt-pro",
        "width": 1200,
        "height": 980,
        "minWidth": 1240,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
