out fil 'c:/Users/yassa/source/co-opt/diagnostics/results/optalix-opd-ray-geometry-capture.txt'

print 'field wavelength pupil_y value_1 value_2 value_3'

do $wavelength = 1,3
  do $pupil_y = -1,1,0.25
    print 'opd' 6 $wavelength $pupil_y [OPD f6 w$wavelength 0 $pupil_y]
    print 'chief_xyz' 6 $wavelength $pupil_y [X s16 w$wavelength f6 0 0] [Y s16 w$wavelength f6 0 0] [Z s16 w$wavelength f6 0 0]
    print 'sample_xyz' 6 $wavelength $pupil_y [X s16 w$wavelength f6 0 $pupil_y] [Y s16 w$wavelength f6 0 $pupil_y] [Z s16 w$wavelength f6 0 $pupil_y]
    print 'chief_dir' 6 $wavelength $pupil_y [CX s16 w$wavelength f6 0 0] [CY s16 w$wavelength f6 0 0] [CZ s16 w$wavelength f6 0 0]
    print 'sample_dir' 6 $wavelength $pupil_y [CX s16 w$wavelength f6 0 $pupil_y] [CY s16 w$wavelength f6 0 $pupil_y] [CZ s16 w$wavelength f6 0 $pupil_y]
    print 'path_opl' 6 $wavelength $pupil_y [PATH s1..16 w$wavelength f6 0 0] [OPL s1..16 w$wavelength f6 0 0] [PATH s1..16 w$wavelength f6 0 $pupil_y] [OPL s1..16 w$wavelength f6 0 $pupil_y]
  enddo
enddo

out t