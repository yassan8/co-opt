out fil 'c:/Users/yassa/source/co-opt/diagnostics/results/optalix-wav-raic-file-ab-capture.txt'

print '=== SAVED SETTING FILE TEST ==='
print 'Run this macro once after loading each saved-setting test OTX file.'

print '=== WAV FIELD 1 ==='
wav f1
print '=== WAV FIELD 6 ==='
wav f6
print '=== WAV FIELD 11 ==='
wav f11

print 'field wavelength pupil_x pupil_y opd'
do $wavelength = 1,3
  print 6 $wavelength 0.0 -0.75 [OPD f6 w$wavelength 0.0 -0.75]
  print 6 $wavelength 0.0 0.0 [OPD f6 w$wavelength 0.0 0.0]
  print 6 $wavelength 0.0 0.75 [OPD f6 w$wavelength 0.0 0.75]
  print 6 $wavelength -0.75 0.0 [OPD f6 w$wavelength -0.75 0.0]
  print 6 $wavelength 0.75 0.0 [OPD f6 w$wavelength 0.75 0.0]
enddo

out t