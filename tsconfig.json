{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    
    // TypeScript migration settings - 段階的移行のため緩和
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "types",
    "**/*.js",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "*.config.ts",
    "vite.config.ts",
    "tsconfig.node.json"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
